# Copy this file to .env and add your own Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
COLPALI_MODEL=vidore/colqwen2-v1.0
RENDER_DPI=100
BATCH_SIZE=1
# Hugging Face Hub settings (moves large ~9 GB model cache off low-capacity C: drive)
HF_HUB_DISABLE_XET=1
HF_HOME=D:\huggingface_cache
